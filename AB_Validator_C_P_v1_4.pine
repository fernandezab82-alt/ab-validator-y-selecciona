levelBufferATR = input.float(0.1, "Margen/tolerancia del nivel en ATR", minval = 0, maxval = 1, step = 0.05, group = G_SETUP, display = display.none)
wickRatio = input.float(1.5, "Rechazo: mecha / cuerpo minimo", minval = 1, maxval = 5, step = 0.25, group = G_SETUP, display = display.none)
minimumRR = input.float(1.5, "Espacio minimo / riesgo", minval = 1, maxval = 5, step = 0.1, group = G_SETUP, display = display.none)
useMinTargetATR = input.bool(false, "Exigir distancia minima al primer objetivo en ATR", group = G_SETUP, tooltip = "Apagado por defecto. El primer obstaculo sigue siendo el objetivo usado para espacio y RR; nunca se salta para aprobar el filtro.", display = display.none)
minimumTargetATR = input.float(0.5, "Distancia minima objetivo / ATR", minval = 0.1, maxval = 5, step = 0.1, group = G_SETUP, tooltip = "Parametro inicial sin validar. Usa ATR de 5m RTH al emitir, que queda congelado junto con entrada y objetivo.", display = display.none)
allowProjection = input.bool(false, "Si no hay nivel objetivo: proyectar rango 15m", group = G_SETUP, tooltip = "Apagado: ESPERAR si no hay objetivo conocido. Encendido: objetivo a una altura del rango inicial desde la entrada; se marca PROY, no resistencia/soporte observado.", display = display.none)

maxAdvanceATR = input.float(0.5, "Expira al avanzar a favor mas de ATR", minval = 0.1, maxval = 3, step = 0.1, group = G_LIFE, display = display.none)
maxAgeBars = input.int(3, "Expira tras N velas RTH posteriores", minval = 1, maxval = 12, group = G_LIFE, display = display.none)
maxDailySignals = input.int(2, "Maximo de candidatos por activo y dia", minval = 1, maxval = 10, group = G_LIFE, display = display.none)
cooldownBars = input.int(3, "Pausa tras invalidacion/objetivo/expiracion: velas", minval = 1, maxval = 12, group = G_LIFE, display = display.none)
cancelOnTrendLoss = input.bool(true, "Expirar si pierde tendencia/EMA/VWAP o veto ETF", group = G_LIFE, tooltip = "RCI, volumen y reaccion se guardan al emitir; no se exige repetir esos eventos en cada vela.", display = display.none)

showPanel = input.bool(true, "Mostrar panel", group = G_VISUAL, display = display.none)
panelView = input.string("Compacto", "Vista del panel", options = ["Compacto", "Detallado"], group = G_VISUAL, tooltip = "Compacto: nueve bloques, estado y niveles. Cada bloque exige TODOS sus filtros activos. Detallado conserva las veinte condiciones individuales. Solo cambia la presentacion.", display = display.none)
panelLocation = input.string("Arriba derecha", "Ubicacion", options = ["Arriba derecha", "Abajo derecha", "Abajo izquierda"], group = G_VISUAL, display = display.none)
showLevels = input.bool(true, "Mostrar entrada, invalidacion y objetivo activos", group = G_VISUAL, display = display.none)
showBackground = input.bool(true, "Fondo tenue mientras el candidato es valido", group = G_VISUAL, display = display.none)
dynamicAlerts = input.bool(true, "Alertas dinamicas con niveles y motivo", group = G_VISUAL, tooltip = "Crear una alerta de 'Cualquier llamada a alert()'. Tambien hay cinco condiciones individuales. Tras cambiar ajustes, especialmente noticias, RECREAR las alertas.", display = display.none)
diagnosticMode = input.bool(false, "Mostrar tabla de diagnostico", group = G_DIAG, tooltip = "No relaja filtros. N: cierres RTH en horario; ND: N con dataGate. S: velas rawLong/rawShort; SD: S con dataGate. Direccionales SOLO sobre S/SD. %ND muestra incidencia setup+filtro sobre ND. Casi: vela raw con exactamente un gate activo falso; OFF no cuenta. Una misma ruptura puede tener varias velas raw. El motor condiciona raw tambien a premarket/resultados/liquidez. Bloqueos propios y embudo se muestran en la otra vista. No es un backtest ni tasa de acierto.", display = display.none)
diagnosticView = input.string("Embudo y bloqueos", "Vista del diagnostico", options = ["Embudo y bloqueos", "Filtros y casi senales"], group = G_DIAG, tooltip = "Ambas vistas conservan los mismos contadores y senales. Embudo: oportunidades unicas por ruptura, descartes aparte. Filtros: porcentajes por vela raw y casi senales originales.", display = display.none)
diagnosticLocation = input.string("Arriba izquierda", "Ubicacion diagnostico", options = ["Arriba izquierda", "Abajo izquierda", "Arriba derecha", "Abajo derecha"], group = G_DIAG, tooltip = "Elegir una esquina distinta a la del panel principal.", display = display.none)

f_key(int t) =>
    year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)

f_price(float x) =>
    na(x) ? "N/D" : str.tostring(x, format.mintick)

f_stamp(int t) =>
    na(t) ? "N/D" : str.format_time(t, "MM-dd HH:mm", TZ)

f_number(float x) =>
    na(x) ? "N/D" : str.tostring(x, "#.00")

f_rate(int passed, int total) =>
    total > 0 ? str.tostring(100.0 * passed / total, "#.0") + "%" : "N/D"

// Valida formato y calendario. Rechaza fechas normalizadas (p.ej. febrero 30).
f_eventNY(string value, bool enabled) =>
    int result = na
    if enabled
        bool formatOK = str.length(value) == 16 and str.substring(value, 4, 5) == "-" and str.substring(value, 7, 8) == "-" and str.substring(value, 10, 11) == " " and str.substring(value, 13, 14) == ":"
        string digits = "0123456789"
        if formatOK
            for i = 0 to 15
                if i != 4 and i != 7 and i != 10 and i != 13
                    formatOK := formatOK and str.contains(digits, str.substring(value, i, i + 1))
        if not formatOK
            runtime.error("Noticias: usar YYYY-MM-DD HH:mm, hora de Nueva York: " + value)
        int y = int(str.tonumber(str.substring(value, 0, 4)))
        int m = int(str.tonumber(str.substring(value, 5, 7)))
        int d = int(str.tonumber(str.substring(value, 8, 10)))
        int h = int(str.tonumber(str.substring(value, 11, 13)))
        int n = int(str.tonumber(str.substring(value, 14, 16)))
        if y < 2000 or y > 2100 or m < 1 or m > 12 or d < 1 or d > 31 or h < 0 or h > 23 or n < 0 or n > 59
            runtime.error("Noticias: fecha/hora NY fuera de rango: " + value)
        result := timestamp(TZ, y, m, d, h, n)
        if year(result, TZ) != y or month(result, TZ) != m or dayofmonth(result, TZ) != d or hour(result, TZ) != h or minute(result, TZ) != n
            runtime.error("Noticias: fecha/hora inexistente en Nueva York: " + value)
    result

// INTEGRACION: colocar junto a los otros inputs, despues de TZ.
const string G_EARN = "01C - Resultados - RECREAR ALERTAS al cambiar"
enableEarningsBlock = input.bool(true, "Bloquear resultados: dia y siguiente sesion", group = G_EARN, tooltip = "Solo acciones y ADR; ETF N/A. La fecha automatica es un snapshot obtenido al cargar, no un calendario historico ni una actualizacion continua. Sin fecha util o sin calendario: ESPERAR. Historial anterior a la observacion: no verificable y bloqueado. RECREAR las alertas despues de cambios o para actualizar el snapshot.", display = display.none)
manualEarningsDateNY = input.string("", "Fecha manual de respaldo NY: YYYY-MM-DD", group = G_EARN, tooltip = "Vacio = sin respaldo. Fecha del reporte del activo de ESTE grafico, en Nueva York. Se usa si la automatica falta o ya quedo obsoleta. Su ventana conocida se respeta siempre, incluso si la automatica ya cambio al proximo trimestre. No certifica la ausencia de otros reportes historicos. RECREAR ALERTAS despues de cambiar.", display = display.none)
manualEarningsSymbol = input.symbol("", "Simbolo al que pertenece la fecha manual", group = G_EARN, tooltip = "Obligatorio si ingresa una fecha manual. La fecha solo se usa cuando el simbolo coincide con el activo del grafico, para evitar reutilizarla al cambiar de accion. RECREAR ALERTAS al cambiar.", display = display.none)


// INTEGRACION: colocar despues de f_key() y f_eventNY().
// sessionKey y previousSessionKey proceden exclusivamente del calendario SPY.
// Incluye el dia reportado y la sesion siguiente realmente observada.
// Si el reporte cae sin sesion, incluye la primera sesion posterior.
f_earningsWindow(int reportKey, int sessionKey, int previousSessionKey) =>
    not na(reportKey) and not na(sessionKey) and not na(previousSessionKey) and (sessionKey == reportKey or (previousSessionKey <= reportKey and reportKey < sessionKey))

// Diferencia de FECHAS civiles NY: no cuenta sesiones bursatiles.
// Reanclar esas fechas en UTC evita errores de una hora por cambios DST.
f_earningsCalendarDays(int fromStamp, int toStamp) =>
    int result = na
    if not na(fromStamp) and not na(toStamp)
        int fromCivil = timestamp("UTC", year(fromStamp, TZ), month(fromStamp, TZ), dayofmonth(fromStamp, TZ), 0, 0)
        int toCivil = timestamp("UTC", year(toStamp, TZ), month(toStamp, TZ), dayofmonth(toStamp, TZ), 0, 0)
        result := int(math.round((toCivil - fromCivil) / 86400000.0))
    result


f_gateDisabled(int i) =>
    (i == 4 and not useDailyStructure) or (i == 6 and not useStructure) or (i == 11 and not useCrossETF) or (i == 14 and not useMinTargetATR) or (i == 17 and premarketMode != "Exigir") or (i == 18 and (not enableEarningsBlock or syminfo.type == "fund"))

f_directionalGate(int i) =>
    (i >= 3 and i <= 11) or i == 13 or i == 14

// Lista permitida: excluye cripto, futuros, forex, indices y derivados.
// country es el mercado/proveedor de cotizacion, no el domicilio del emisor.
// Lista cerrada de identificadores admitidos. Un proveedor desconocido se
// rechaza explicitamente: no basta con que el pais sea US para excluir OTC.
f_supportedVenue(string prefix) =>
    prefix == "NASDAQ" or prefix == "NYSE" or prefix == "AMEX" or prefix == "CBOE" or prefix == "BATS"

f_otcVenue(string prefix) =>
    str.contains(str.upper(prefix), "OTC") or str.contains(str.upper(prefix), "PINK")

f_supportedAsset(string assetType, string marketCountry) =>
    (assetType == "stock" or assetType == "fund" or assetType == "dr") and marketCountry == "US"

// Spearman con rangos medios para precios empatados.
// Offset cero = barra mas nueva: una subida monotona produce +100.
f_rci(float src, int length) =>
    float result = na
    if not na(src[length - 1])
        float meanRank = (length - 1) / 2.0
        float covariance = 0.0
        float priceVariance = 0.0
        float timeVariance = 0.0
        for i = 0 to length - 1
            float lower = 0.0
            float equal = 0.0
            for j = 0 to length - 1
                lower += src[j] < src[i] ? 1.0 : 0.0
                equal += src[j] == src[i] ? 1.0 : 0.0
            float priceRank = lower + (equal - 1.0) / 2.0
            float timeRank = length - 1 - i
            float x = priceRank - meanRank
            float y = timeRank - meanRank
            covariance += x * y
            priceVariance += x * x
            timeVariance += y * y
        result := priceVariance > 0 and timeVariance > 0 ? 100 * covariance / math.sqrt(priceVariance * timeVariance) : 0
    result

// Esta funcion se ejecuta DENTRO del contexto de 5m de sesion regular.
f_regular5() =>
    int key = f_key(time)
    var int previousKey = na
    bool newDay = na(previousKey) or key != previousKey
    var int sequence = 0
    sequence += 1
    var float pv = 0.0
    var float vv = 0.0
    var float orbHigh = na
    var float orbLow = na
    var int orbCount = 0
    var float dayHigh = na
    var float dayLow = na
    var int lastLongRecovery = na
    var int lastShortRecovery = na
    int slots = 78
    int rows = rvolDays * 2 + 1
    var array<float> slotVolumes = array.new_float(rows * slots, na)
    var int row = -1
    if newDay
        previousKey := key
        pv := 0.0
        vv := 0.0
        orbHigh := na
        orbLow := na
        orbCount := 0
        dayHigh := na
        dayLow := na
        lastLongRecovery := na
        lastShortRecovery := na
        row := (row + 1) % rows
        for s = 0 to slots - 1
            array.set(slotVolumes, row * slots + s, na)
    float previousDayHigh = dayHigh
    float previousDayLow = dayLow
    int slot = int(math.floor((hour(time, TZ) * 60 + minute(time, TZ) - 570) / 5.0))
    if slot >= 0 and slot <= 2
        orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
        orbLow := na(orbLow) ? low : math.min(orbLow, low)
        orbCount += 1
    dayHigh := na(dayHigh) ? high : math.max(dayHigh, high)
    dayLow := na(dayLow) ? low : math.min(dayLow, low)
    if not na(volume)
        pv += hlc3 * volume
        vv += volume
    float vwapValue = vv > 0 ? pv / vv : na
    float historicalVolume = 0.0
    int volumeSamples = 0
    if slot >= 0 and slot < slots
        for d = 1 to rvolDays * 2
            int pastRow = (row - d + rows) % rows
            float oldVolume = array.get(slotVolumes, pastRow * slots + slot)
            if not na(oldVolume) and volumeSamples < rvolDays
                historicalVolume += oldVolume
                volumeSamples += 1
        array.set(slotVolumes, row * slots + slot, volume)
    float relativeVolume = volumeSamples > 0 and historicalVolume > 0 ? volume / (historicalVolume / volumeSamples) : na
    float atrValue = ta.atr(atrLen)
    float fastEMA = ta.ema(close, fastLen)
    float slowEMA = ta.ema(close, slowLen)
    float rciValue = f_rci(close, rciLen)
    bool recoveryUp = ta.crossover(rciValue, -rciExtreme)
    bool recoveryDown = ta.crossunder(rciValue, rciExtreme)
    if recoveryUp
        lastLongRecovery := sequence
    if recoveryDown
        lastShortRecovery := sequence
    bool longRCI = not na(lastLongRecovery) and sequence - lastLongRecovery <= rciWindow and rciValue > -rciExtreme and (na(lastShortRecovery) or lastLongRecovery > lastShortRecovery)
    bool shortRCI = not na(lastShortRecovery) and sequence - lastShortRecovery <= rciWindow and rciValue < rciExtreme and (na(lastLongRecovery) or lastShortRecovery > lastLongRecovery)
    var float lastPivotHigh = na
    var float lastPivotLow = na
    float knownPivotHigh = lastPivotHigh
    float knownPivotLow = lastPivotLow
    float newPH = ta.pivothigh(high, pivotLen, pivotLen)
    float newPL = ta.pivotlow(low, pivotLen, pivotLen)
    if not na(newPH)
        lastPivotHigh := newPH
    if not na(newPL)
        lastPivotLow := newPL
    [time, time_close, key, sequence, close, open, high, low, close[1], atrValue, fastEMA, slowEMA, rciValue, longRCI, shortRCI, vwapValue, relativeVolume, volumeSamples, orbHigh, orbLow, orbCount == 3, previousDayHigh, previousDayLow, knownPivotHigh, knownPivotLow, session.islastbar_regular]

// EMA y pivotes solo con barras RTH de 60 minutos COMPLETOS.
// La fraccion final de 30m no modifica las EMAs ni los pivotes.
f_closedHour() =>
    var float fastEMA = na
    var float slowEMA = na
    var float lastClose = na
    var int lastTimestamp = na
    var int count = 0
    var array<float> highs = array.new_float()
    var array<float> lows = array.new_float()
    var float lastHigh = na
    var float previousHigh = na
    var float lastLow = na
    var float previousLow = na
    if time_close - time == 60 * 60 * 1000
        count += 1
        fastEMA := na(fastEMA) ? close : fastEMA + 2.0 / (hourFastLen + 1) * (close - fastEMA)
        slowEMA := na(slowEMA) ? close : slowEMA + 2.0 / (hourSlowLen + 1) * (close - slowEMA)
        lastClose := close
        lastTimestamp := time_close
        array.push(highs, high)
        array.push(lows, low)
        int needed = pivotLen * 2 + 1
        if array.size(highs) > needed
            array.shift(highs)
            array.shift(lows)
        if array.size(highs) == needed
            float centerHigh = array.get(highs, pivotLen)
            float centerLow = array.get(lows, pivotLen)
            bool isHigh = true
            bool isLow = true
            for i = 0 to needed - 1
                if i != pivotLen
                    isHigh := isHigh and centerHigh > array.get(highs, i)
                    isLow := isLow and centerLow < array.get(lows, i)
            if isHigh
                previousHigh := lastHigh
                lastHigh := centerHigh
            if isLow
                previousLow := lastLow
                lastLow := centerLow
    [lastClose[1], fastEMA[1], slowEMA[1], lastHigh[1], previousHigh[1], lastLow[1], previousLow[1], lastTimestamp[1], count[1]]

f_closedDaily() =>
    float fastEMA = ta.ema(close, dailyFastLen)
    float slowEMA = ta.ema(close, dailySlowLen)
    float ph = ta.pivothigh(high, dailyPivotLen, dailyPivotLen)
    float pl = ta.pivotlow(low, dailyPivotLen, dailyPivotLen)
    var float lastHigh = na
    var float previousHigh = na
    var float lastLow = na
    var float previousLow = na
    if not na(ph)
        previousHigh := lastHigh
        lastHigh := ph
    if not na(pl)
        previousLow := lastLow
        lastLow := pl
    // Solo time_close y fecha actuales: metadatos del horario, no precios futuros.
    [close[1], fastEMA[1], slowEMA[1], high[1], low[1], time_close[1], bar_index[1] + 1, time_close, f_key(time), lastHigh[1], previousHigh[1], lastLow[1], previousLow[1]]

// Se solicita horario extendido aunque el grafico muestre solo RTH.
// Nunca reutiliza el PM de otra fecha.
f_premarket() =>
    int key = f_key(time)
    var int oldKey = na
    var float pmHigh = na
    var float pmLow = na
    if na(oldKey) or oldKey != key
        oldKey := key
        pmHigh := na
        pmLow := na
    int minuteNY = hour(time, TZ) * 60 + minute(time, TZ)
    if minuteNY >= 240 and minuteNY < 570
        pmHigh := na(pmHigh) ? high : math.max(pmHigh, high)
        pmLow := na(pmLow) ? low : math.min(pmLow, low)
    [pmHigh, pmLow, key]

f_cross5() =>
    int key = f_key(time)
    var int previousKey = na
    var float pv = 0.0
    var float vv = 0.0
    if na(previousKey) or key != previousKey
        previousKey := key
        pv := 0.0
        vv := 0.0
    if not na(volume)
        pv += hlc3 * volume
        vv += volume
    [close, ta.ema(close, fastLen), ta.ema(close, slowLen), vv > 0 ? pv / vv : na, time, time_close, syminfo.type, syminfo.country, syminfo.ticker, syminfo.prefix, syminfo.currency]

f_addLevel(array<float> values, array<string> names, float value, string name) =>
    if not na(value)
        bool duplicate = false
        if array.size(values) > 0
            for i = 0 to array.size(values) - 1
                // Solo igualdad numerica: no fusionar obstaculos distintos.
                if math.abs(array.get(values, i) - value) <= syminfo.mintick * 0.000001
                    duplicate := true
        if not duplicate
            array.push(values, value)
            array.push(names, name)

f_nextLevel(array<float> values, array<string> names, float entry, int direction) =>
    float best = na
    string bestName = ""
    if array.size(values) > 0
        for i = 0 to array.size(values) - 1
            float level = array.get(values, i)
            // Incluye tambien un obstaculo situado a un solo tick.
            float precision = syminfo.mintick * 0.000001
            bool ahead = direction == 1 ? level > entry + precision : level < entry - precision
            bool closer = na(best) or (direction == 1 ? level < best : level > best)
            if ahead and closer
                best := level
                bestName := array.get(names, i)
    [best, bestName]

f_all(array<bool> gates) =>
    bool pass = true
    for i = 0 to array.size(gates) - 1
        pass := pass and array.get(gates, i)
    pass

f_firstMissing(array<bool> gates, array<string> names) =>
    string result = "ninguno"
    for i = 0 to array.size(gates) - 1
        if not array.get(gates, i) and result == "ninguno"
            result := array.get(names, i)
    result

if barstate.isfirst
    if not chart.is_standard or not timeframe.isminutes or timeframe.multiplier != 5
        runtime.error("AB-Validator C-P: usar velas normales de 5 minutos.")
    if not f_supportedAsset(syminfo.type, syminfo.country)
        runtime.error("AB-Validator C-P v1.4: usar acciones, ETF o ADR cotizados en EE.UU. Tipo recibido: " + syminfo.type + " | Mercado: " + syminfo.country + ". No admite cripto, futuros, forex ni indices.")
    if f_otcVenue(syminfo.prefix)
        runtime.error("AB-Validator C-P v1.4: mercado OTC excluido. Proveedor/mercado: " + syminfo.prefix)
    if not f_supportedVenue(syminfo.prefix)
        runtime.error("AB-Validator C-P v1.4: mercado/proveedor no verificado: " + syminfo.prefix + ". Admitidos: NASDAQ, NYSE, AMEX, CBOE y BATS. No se presume que un proveedor desconocido excluya OTC.")
    if syminfo.currency != "USD"
        runtime.error("AB-Validator C-P v1.4: los umbrales de precio requieren cotizacion en USD. Recibido: " + syminfo.currency)
    if not enableRetest and not enableRejection
        runtime.error("Activar al menos ruptura/retesteo o rechazo.")
    if dailyFastLen >= dailySlowLen or hourFastLen >= hourSlowLen or fastLen >= slowLen
        runtime.error("La longitud EMA rapida debe ser menor que la lenta.")
    if startHour * 60 + startMinute >= endHour * 60 + endMinute
        runtime.error("El inicio debe ser anterior al fin de nuevas senales.")

string regularTicker = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
string extendedTicker = ticker.new(syminfo.prefix, syminfo.ticker, session.extended)
string otherSource = crossETFInput == "" ? (syminfo.ticker == "SPY" ? "NASDAQ:QQQ" : "AMEX:SPY") : crossETFInput
string otherTicker = ticker.modify(otherSource, session = session.regular)
if barstate.isfirst and useCrossETF and ticker.standard(otherSource) == ticker.standard(syminfo.tickerid)
    runtime.error("Elegir un ETF de confirmacion distinto al activo principal.")
[rTime, rCloseTime, rKey, rSeq, rClose, rOpen, rHigh, rLow, rPreviousClose, rATR, rFast, rSlow, rRCI, rRCILong, rRCIShort, rVWAP, rRVOL, rSamples, orbHigh, orbLow, orbReady, previousHOD, previousLOD, pivot5High, pivot5Low, lastRegularBar] = request.security(regularTicker, "5", f_regular5(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[dClose, dFast, dSlow, priorHigh, priorLow, dStamp, dCount, sessionCloseTimestamp, sessionDateKey, dHigh, dPreviousHigh, dLow, dPreviousLow] = request.security(regularTicker, "1D", f_closedDaily(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on, calc_bars_count = 500)
[hClose, hFast, hSlow, hHigh, hPreviousHigh, hLow, hPreviousLow, hStamp, hCount] = request.security(regularTicker, "60", f_closedHour(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on, calc_bars_count = 1500)
// AVG20 solo de dias anteriores cerrados; offset antes de lookahead_on.
[averageDailyVolume, dailyVolumeSamples] = request.security(regularTicker, "1D", [ta.sma(volume, 20)[1], math.sum(not na(volume) ? 1.0 : 0.0, 20)[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on, calc_bars_count = 500)
[pmHigh, pmLow, pmKey] = request.security(extendedTicker, "5", f_premarket(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[oClose, oFast, oSlow, oVWAP, oTime, oCloseTime, oType, oCountry, oSymbol, oPrefix, oCurrency] = request.security(otherTicker, "5", f_cross5(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[ohClose, ohFast, ohSlow, ohHigh, ohPreviousHigh, ohLow, ohPreviousLow, ohStamp, ohCount] = request.security(otherTicker, "60", f_closedHour(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on, calc_bars_count = 1500)

// Tambien se valida la referencia manual; no se puede introducir un mercado
// excluido como confirmacion. Se espera a disponer de sus metadatos.
if useCrossETF and not na(oTime)
    if oType != "fund" or oCountry != "US" or not f_supportedVenue(oPrefix) or oCurrency != "USD"
        runtime.error("La referencia debe ser un ETF cotizado en EE.UU. Recibido: " + otherSource + " | Tipo: " + oType + " | Mercado: " + oCountry + "/" + oPrefix + " | Moneda: " + oCurrency)
    if oSymbol == syminfo.ticker
        runtime.error("El ETF de referencia no puede ser el propio activo, tampoco desde otro proveedor.")

bool confirmedRTH = barstate.isconfirmed and rTime == time and rCloseTime == time_close
bool pmReady = pmKey == rKey and not na(pmHigh) and not na(pmLow)
int closeMinuteNY = hour(rCloseTime, TZ) * 60 + minute(rCloseTime, TZ)
bool scheduleReady = not na(sessionCloseTimestamp) and sessionDateKey == rKey and f_key(sessionCloseTimestamp - 1) == rKey
int effectiveStart = math.max(585, startHour * 60 + startMinute)
int effectiveEnd = scheduleReady ? math.min(endHour * 60 + endMinute, hour(sessionCloseTimestamp, TZ) * 60 + minute(sessionCloseTimestamp, TZ) - closeBufferMinutes) : 0
string startLabel = str.tostring(int(effectiveStart / 60), "00") + ":" + str.tostring(effectiveStart % 60, "00")
string endLabel = str.tostring(int(effectiveEnd / 60), "00") + ":" + str.tostring(effectiveEnd % 60, "00")
bool timeGate = scheduleReady and closeMinuteNY >= effectiveStart and closeMinuteNY <= effectiveEnd and orbReady and not lastRegularBar
// Reloj del diagnostico: no depende de ORB, noticias, datos de filtros o cupo.
bool diagnosticWindow = scheduleReady and closeMinuteNY >= effectiveStart and closeMinuteNY <= effectiveEnd and not lastRegularBar
var int blockedDate = f_eventNY(blockedDateNY + " 00:00", blockDay)
var array<int> newsEvents = array.from(f_eventNY(event1NY, event1Enabled), f_eventNY(event2NY, event2Enabled), f_eventNY(event3NY, event3Enabled), f_eventNY(event4NY, event4Enabled), f_eventNY(event5NY, event5Enabled), f_eventNY(event6NY, event6Enabled))
bool blockedByDate = blockDay and f_key(rCloseTime - 1) == f_key(blockedDate)
bool blockedByEvent = false
int blockingEvent = na
int nextNewsEvent = na
int nextNewsNumber = na
for i = 0 to array.size(newsEvents) - 1
    int eventTime = array.get(newsEvents, i)
    if not na(eventTime)
        if rCloseTime >= eventTime - minutesBefore * 60000 and rCloseTime <= eventTime + minutesAfter * 60000
            blockedByEvent := true
            blockingEvent := eventTime
        // Solo informativo; timenow NO participa en senales ni estadisticas.
        if eventTime >= timenow and (na(nextNewsEvent) or eventTime < nextNewsEvent)
            nextNewsEvent := eventTime
            nextNewsNumber := i + 1
bool newsGate = not blockedByDate and not blockedByEvent
bool dailyReady = dCount >= math.max(dailyFastLen, dailySlowLen) and not na(dFast) and not na(dSlow)
bool hourReady = hCount >= math.max(hourFastLen, hourSlowLen) and not na(hFast) and not na(hSlow)
bool crossReady = oTime == time and oCloseTime == time_close and ohCount >= math.max(hourFastLen, hourSlowLen) and not na(oVWAP)
bool dataGate = scheduleReady and dailyReady and hourReady and rATR > 0 and not na(rRCI) and not na(rVWAP) and (not useCrossETF or crossReady)
// Protecciones propias: N/D de liquidez/reportes no se oculta en dataGate.
bool premarketGate = premarketMode != "Exigir" or pmReady
bool liquidityDataReady = dailyVolumeSamples == 20 and not na(averageDailyVolume) and not na(rClose)
bool liquidityPriceOK = not na(rClose) and rClose >= minimumSharePrice
bool liquidityVolumeOK = liquidityDataReady and averageDailyVolume >= minimumDailyVolume
bool liquidityGate = liquidityDataReady and liquidityPriceOK and liquidityVolumeOK
string liquidityPanel = not liquidityDataReady ? "Liquidez: N/D (requiere 20 sesiones RTH cerradas)" : "ADV20 " + str.tostring(averageDailyVolume, "#.0") + "/" + str.tostring(minimumDailyVolume, "#.0") + " acciones | C " + f_price(rClose) + "/" + f_price(minimumSharePrice) + " USD | " + (liquidityGate ? "OK" : "BLOQUEO")
// INTEGRACION: despues de request.security() principal y de las definiciones
// rKey/rCloseTime/confirmedRTH; antes del motor de candidatos.
// Requiere TZ, f_key(), f_eventNY(), f_earningsWindow() y los inputs.
// No modifica dataGate: earningsGate es una condicion operativa separada.
bool earningsApplies = syminfo.type == "stock" or syminfo.type == "dr"
bool earningsActive = enableEarningsBlock and earningsApplies

// Datos de calendario, no precios. No se proyecta ninguna sesion futura.
[earningsSessionOpen, earningsPreviousSessionOpen] = request.security(ticker.new("AMEX", "SPY", session.regular), "1D", [time, time[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
int earningsSessionKey = f_key(earningsSessionOpen)
int earningsPreviousSessionKey = f_key(earningsPreviousSessionOpen)
bool earningsCalendarReady = not na(earningsSessionOpen) and not na(earningsPreviousSessionOpen) and earningsSessionKey == rKey and earningsPreviousSessionKey < earningsSessionKey

// Snapshot real obtenido durante ESTA ejecucion. No se retropropaga como
// prueba de que se conocia el calendario al cerrar barras anteriores.
var int earningsObservationTimestamp = timenow
var int earningsAutoSnapshot = earningsApplies ? earnings.future_time : na
var string earningsManualText = str.trim(manualEarningsDateNY)
bool earningsManualSymbolMatches = manualEarningsSymbol != "" and ticker.standard(manualEarningsSymbol) == ticker.standard(syminfo.tickerid)
var int earningsManualParsedTimestamp = f_eventNY(earningsManualText + " 00:00", earningsActive and earningsManualText != "")
int earningsManualTimestamp = earningsManualSymbolMatches ? earningsManualParsedTimestamp : na
int earningsAutoKey = f_key(earningsAutoSnapshot)
int earningsManualKey = f_key(earningsManualTimestamp)

// El dato EPS puede llegar al final del dia o en la primera barra disponible.
// Se conserva la fecha de RECEPCION en el grafico, no una hora de publicacion
// que esta API no certifica. La deteccion puede bloquear una sesion extra.
float earningsReportedEPS = request.earnings(ticker.standard(syminfo.tickerid), earnings.actual, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
var int earningsLastReportedBarTime = na
var int earningsLastReportedKey = na
if barstate.isconfirmed and earningsApplies and not na(earningsReportedEPS)
    earningsLastReportedBarTime := time
    earningsLastReportedKey := f_key(time)

bool earningsAutoWindow = earningsCalendarReady and f_earningsWindow(earningsAutoKey, earningsSessionKey, earningsPreviousSessionKey)
bool earningsManualWindow = earningsCalendarReady and f_earningsWindow(earningsManualKey, earningsSessionKey, earningsPreviousSessionKey)
bool earningsReceivedWindow = earningsCalendarReady and f_earningsWindow(earningsLastReportedKey, earningsSessionKey, earningsPreviousSessionKey)
// Una fecha vieja fuera de su ventana NO se considera cobertura vigente.
bool earningsAutoUseful = not na(earningsAutoSnapshot) and (earningsAutoKey >= rKey or earningsAutoWindow)
bool earningsManualUseful = not na(earningsManualTimestamp) and (earningsManualKey >= rKey or earningsManualWindow)
int earningsSelectedTimestamp = earningsAutoUseful ? earningsAutoSnapshot : earningsManualUseful ? earningsManualTimestamp : na
string earningsDateSource = earningsAutoUseful ? "AUTO snapshot" : earningsManualUseful ? "MANUAL respaldo" : "N/D (sin fecha vigente)"

bool earningsHistoryUnknown = earningsActive and (na(rCloseTime) or rCloseTime < earningsObservationTimestamp)
bool earningsMissingDate = earningsActive and not (earningsAutoUseful or earningsManualUseful)
bool earningsBlockedWindow = earningsActive and (earningsAutoWindow or earningsManualWindow or earningsReceivedWindow)
bool earningsCalendarMissing = earningsActive and not earningsCalendarReady
bool earningsGate = not earningsActive or (not earningsHistoryUnknown and not earningsMissingDate and not earningsCalendarMissing and not earningsBlockedWindow)

string earningsWindowSource = earningsAutoWindow ? "fecha AUTO" : earningsManualWindow ? "fecha MANUAL" : earningsReceivedWindow ? "reporte recibido" : ""
string earningsReason = not earningsApplies ? "N/A (ETF)" : not enableEarningsBlock ? "OFF" : earningsHistoryUnknown ? "Historial de resultados no verificable" : earningsCalendarMissing ? "Calendario RTH SPY N/D o no sincronizado" : earningsBlockedWindow ? "Reporte de resultados: " + earningsWindowSource : earningsMissingDate ? "Fecha resultados N/D u obsoleta; actualizar/recrear alerta" : "Sin bloqueo conocido: " + earningsDateSource

// Solo informativo. timenow no cambia filtros de precio ni reconstruye pasado.
int earningsDaysCalendar = f_earningsCalendarDays(timenow, earningsSelectedTimestamp)
string earningsSelectedLabel = na(earningsSelectedTimestamp) ? "N/D" : str.format_time(earningsSelectedTimestamp, "yyyy-MM-dd", TZ)
string earningsManualLabel = na(earningsManualTimestamp) ? "" : " | respaldo " + str.format_time(earningsManualTimestamp, "yyyy-MM-dd", TZ)
string earningsObservationLabel = str.format_time(earningsObservationTimestamp, "yyyy-MM-dd HH:mm:ss", TZ)
string earningsPanel = not earningsApplies ? "Resultados N/A (ETF)" : not enableEarningsBlock ? "Resultados OFF" : earningsReason + " | " + earningsDateSource + " " + earningsSelectedLabel + (na(earningsDaysCalendar) ? "" : " | " + str.tostring(earningsDaysCalendar) + " dias calendario (no sesiones)") + earningsManualLabel
string earningsCoveragePanel = earningsActive ? "Resultados: historial no verificable; observacion desde " + earningsObservationLabel + " NY; recargar NO reconstruye candidatos anteriores" + (earningsManualText != "" and not earningsManualSymbolMatches ? " | Respaldo ignorado: simbolo no coincide" : "") : not earningsApplies ? "Resultados: ETF N/A" : "Resultados: filtro OFF; no certifica cobertura"


bool dailyLong = dClose > dSlow and dFast > dSlow
bool dailyShort = dClose < dSlow and dFast < dSlow
bool dailyStructureLong = not useDailyStructure or (not na(dPreviousHigh) and not na(dPreviousLow) and dHigh > dPreviousHigh and dLow > dPreviousLow)
bool dailyStructureShort = not useDailyStructure or (not na(dPreviousHigh) and not na(dPreviousLow) and dHigh < dPreviousHigh and dLow < dPreviousLow)
bool hourlyLong = hClose > hFast and hFast > hSlow
bool hourlyShort = hClose < hFast and hFast < hSlow
bool structureLong = not useStructure or (not na(hPreviousHigh) and not na(hPreviousLow) and hHigh > hPreviousHigh and hLow > hPreviousLow)
bool structureShort = not useStructure or (not na(hPreviousHigh) and not na(hPreviousLow) and hHigh < hPreviousHigh and hLow < hPreviousLow)
bool emaLong = rFast > rSlow and rClose > rFast
bool emaShort = rFast < rSlow and rClose < rFast
bool vwapLong = rClose > rVWAP
bool vwapShort = rClose < rVWAP
bool otherBearish = crossReady and oClose < oVWAP and oFast < oSlow and ohFast < ohSlow
bool otherBullish = crossReady and oClose > oVWAP and oFast > oSlow and ohFast > ohSlow
bool crossLong = not useCrossETF or (crossReady and not otherBearish)
bool crossShort = not useCrossETF or (crossReady and not otherBullish)

