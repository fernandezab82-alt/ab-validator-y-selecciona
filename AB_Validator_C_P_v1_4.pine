useStructure = input.bool(true, "Exigir HH/HL o LH/LL en 1h", group = G_TREND, tooltip = "Dos maximos y dos minimos pivote confirmados. Puede restringir mucho las senales.", display = display.none)
useDailyStructure = input.bool(false, "Exigir HH/HL o LH/LL en diario", group = G_TREND, tooltip = "Opcional y apagado por defecto. Compara dos maximos y dos minimos pivote diarios confirmados, disponibles solo tras el cierre diario.", display = display.none)
