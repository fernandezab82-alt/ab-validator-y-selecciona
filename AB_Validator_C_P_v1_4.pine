event3NY = input.string("2026-10-16 14:00", "Fecha/hora NY", inline = "ev3", group = G_NEWS, tooltip = "YYYY-MM-DD HH:mm en America/New_York. RECREAR ALERTAS al modificar.", display = display.none)
event4Enabled = input.bool(false, "Evento 4", inline = "ev4", group = G_NEWS, display = display.none)
