//@version=6
// AB-Validator (vs v1.4) - panel compacto para acciones, ETF y ADR en EE.UU.
// Revision visual: panel agrupado; motor, niveles, filtros y alertas v1.4 intactos.
// Modo estricto. Parametros pendientes de validar en cada activo.
// v1.4: oportunidades con ID unico, bloqueos independientes y liquidez.
// Resultados: snapshot observado desde la carga; no reconstruye candidatos
// historicos de acciones/ADR. Al recargar comienza una nueva cobertura.
// ETFs exentos de resultados. Solo mercados US verificados, cotizacion USD.
// Referencias tecnicas: tradingview.com/pine-script-reference/v6/
// y tradingview.com/pine-script-docs/concepts/other-timeframes-and-data/
// Autor: Abdias Fernandez (apoyado con IA).
// Confirmacion de implementacion: no se copiaron bloques de codigo de
// Signal Forge de LuxAlgo. Se reviso como referencia funcional y se
// implementaron nuevamente los modulos de AB-Validator C-P.
// Se conserva la licencia indicada; esta declaracion no la modifica.
// CC BY-NC-SA 4.0: https://creativecommons.org/licenses/by-nc-sa/4.0/
// No incorpora ejecucion de ordenes ni estadisticas de contratos de opciones.
// Senales y eventos se notifican al cierre de 5m. Invalidacion por toque
// del nivel en una vela POSTERIOR a la emision; no es un stop ejecutado.
indicator("AB-Validator (vs v1.4)", overlay = true, max_labels_count = 200, max_bars_back = 500, dynamic_requests = true)

const string TZ = "America/New_York"
const string G_SESSION = "01 - Horario y noticias"
const string G_NEWS = "01B - Noticias NY - RECREAR ALERTAS al cambiar"
const string G_TREND = "02 - Tendencia y estructura"
const string G_MOM = "03 - Momentum y volumen"
const string G_SETUP = "04 - Nivel y reaccion"
const string G_LIFE = "05 - Validez del candidato"
const string G_VISUAL = "06 - Panel y alertas"
const string G_DIAG = "07 - Diagnostico del modo estricto"
const int GATE_COUNT = 20
const string G_LIQ = "01D - Mercado y liquidez"

startHour = input.int(9, "Inicio: hora NY", minval = 9, maxval = 15, inline = "start", group = G_SESSION, display = display.none)
startMinute = input.int(45, "Minuto", minval = 0, maxval = 59, inline = "start", group = G_SESSION, display = display.none)
endHour = input.int(15, "Fin nuevas senales: hora NY", minval = 10, maxval = 16, inline = "end", group = G_SESSION, display = display.none)
endMinute = input.int(0, "Minuto", minval = 0, maxval = 59, inline = "end", group = G_SESSION, display = display.none)
closeBufferMinutes = input.int(60, "Margen minimo antes del cierre regular (minutos)", minval = 0, maxval = 180, group = G_SESSION, tooltip = "El corte efectivo es el menor entre la hora elegida y el cierre RTH informado por TradingView menos este margen. Revisar los dias de cierre anticipado con el proveedor de datos.", display = display.none)
premarketMode = input.string("Exigir", "Premarket: uso en setups", options = ["Exigir", "Usar si existe", "No usar"], group = G_SESSION, tooltip = "Exigir mantiene el modo estricto original. Usar si existe permite setups sin PM disponible. No usar excluye PM como origen de setups. En TODOS los modos, los niveles PM conocidos siguen contando como primer obstaculo para objetivo/RR. Sin datos no significa sin negociacion.", display = display.none)
minimumDailyVolume = input.float(1000000, "Liquidez: volumen diario medio minimo (acciones)", minval = 1, step = 100000, group = G_LIQ, tooltip = "Promedio de las 20 sesiones RTH cerradas anteriores; excluye hoy. Volumen del proveedor, no necesariamente consolidado. Parametro inicial sin validar. No demuestra liquidez de las opciones.", display = display.none)
minimumSharePrice = input.float(5.0, "Liquidez: precio minimo (USD)", minval = 0.01, step = 0.5, group = G_LIQ, tooltip = "Se compara con el cierre confirmado de 5m. Parametro inicial sin validar. Se requiere cotizacion USD.", display = display.none)
