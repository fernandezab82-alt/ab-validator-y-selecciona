var bool panelFrozen = false
var array<string> gateNames = array.from("Datos/RTH", "Horario y ORB", "Noticias", "Diario EMA", "Estructura diaria", "1h EMA", "Estructura 1h", "5m EMA", "VWAP RTH", "RCI recuperacion", "RVOL ruptura/rechazo", "Otro ETF", "Nivel y reaccion", "Espacio / riesgo", "Distancia objetivo ATR", "Cupo diario", "Pausa / nuevo setup", "Premarket requerido", "Reporte de resultados", "Liquidez")
var array<bool> panelLong = array.new_bool(GATE_COUNT, false)
var array<bool> panelShort = array.new_bool(GATE_COUNT, false)
