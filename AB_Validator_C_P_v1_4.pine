event6Enabled = input.bool(false, "Evento 6", inline = "ev6", group = G_NEWS, display = display.none)
event6NY = input.string("2026-10-19 10:00", "Fecha/hora NY", inline = "ev6", group = G_NEWS, tooltip = "YYYY-MM-DD HH:mm en America/New_York. RECREAR ALERTAS al modificar.", display = display.none)
minutesBefore = input.int(30, "Minutos antes (los 6 eventos)", minval = 0, maxval = 240, inline = "event", group = G_NEWS, display = display.none)
minutesAfter = input.int(30, "Despues", minval = 0, maxval = 240, inline = "event", group = G_NEWS, display = display.none)

dailyFastLen = input.int(20, "EMA diaria rapida", minval = 2, maxval = 100, inline = "daily", group = G_TREND, display = display.none)
dailySlowLen = input.int(50, "Lenta", minval = 3, maxval = 250, inline = "daily", group = G_TREND, display = display.none)
hourFastLen = input.int(20, "EMA 1h rapida", minval = 2, maxval = 100, inline = "hour", group = G_TREND, display = display.none)
hourSlowLen = input.int(50, "Lenta", minval = 3, maxval = 250, inline = "hour", group = G_TREND, display = display.none)
fastLen = input.int(8, "EMA 5m rapida", minval = 2, maxval = 100, inline = "five", group = G_TREND, display = display.none)
