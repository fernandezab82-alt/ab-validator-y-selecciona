crossETFInput = input.symbol("", "ETF de referencia (vacio = automatico)", group = G_TREND, tooltip = "Vacio: SPY confirma las acciones/ETF/ADR; para SPY se usa QQQ. Puede elegir otro ETF cotizado en EE.UU., por ejemplo QQQ o uno sectorial. No elegir el propio activo, aunque sea otro proveedor. El panel informa la ultima vela recibida al cierre de 5m.", display = display.none)

rciLen = input.int(9, "RCI: longitud en 5m", minval = 3, maxval = 30, group = G_MOM, display = display.none)
rciExtreme = input.float(80, "RCI: umbral extremo +/-", minval = 40, maxval = 95, step = 5, group = G_MOM, display = display.none)
rciWindow = input.int(3, "Recuperacion RCI valida: velas previas", minval = 0, maxval = 12, group = G_MOM, tooltip = "CALL: cruce ascendente de -umbral. PUT: cruce descendente de +umbral. Se acepta en la vela actual o las N anteriores de esta sesion. No se arrastra de ayer.", display = display.none)
rvolDays = input.int(20, "RVOL: muestras anteriores del mismo horario", minval = 5, maxval = 60, group = G_MOM, display = display.none)
rvolMinSamples = input.int(20, "RVOL: minimo de muestras por horario", minval = 3, maxval = 60, group = G_MOM, tooltip = "Se buscan las ultimas N muestras del mismo tramo de 5m, excluyendo hoy, hasta 2*N sesiones atras para omitir sesiones cortas o datos ausentes. Se muestra n/N; el minimo se limita al total configurado.", display = display.none)
rvolThreshold = input.float(1.2, "RVOL minimo", minval = 0.1, maxval = 5, step = 0.1, group = G_MOM, display = display.none)
atrLen = input.int(14, "ATR en 5m RTH", minval = 2, maxval = 100, group = G_MOM, tooltip = "Solo barras regulares. El true range de la apertura SI incluye el gap frente al cierre regular anterior.", display = display.none)

enableRetest = input.bool(true, "Ruptura y retesteo", group = G_SETUP, display = display.none)
enableRejection = input.bool(false, "Rechazo con mecha (setup separado)", group = G_SETUP, display = display.none)
